---
import Base from '../../layouts/Base.astro';
import ReleasesExplorer from '../../components/releases/ReleasesExplorer';
import { getReleases } from '../../lib/releases';
const releases = await getReleases();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Releases & Android downloads · Money Plant" description="Follow Money Plant’s growth: readable release notes, improvements, bug fixes and versioned Android APK downloads." ogImage={`${base}/og/releases.png`}>
  <section class="container-site release-page">
    <div class="section-heading"><p class="eyebrow">The growth vine</p><h1>Small updates.<br />A growing garden.</h1><p>Every published version, newest first. See what changed and choose your Android download.</p></div>
    <ReleasesExplorer releases={releases} base={base} client:load />
  </section>
</Base>
