---
// CSS-3D phone frame with real app screenshots that cycle through the 5 themes
// and follow the active site theme. Tilts toward the cursor on fine pointers.
import { getImage } from 'astro:assets';
import gardenShot from '../../assets/screens/garden/overview.png';
import sakuraShot from '../../assets/screens/sakura/overview.png';
import neonShot from '../../assets/screens/neon/overview.png';
import mangoShot from '../../assets/screens/mango/overview.png';
import oceanShot from '../../assets/screens/ocean/overview.png';

const sources = { garden: gardenShot, sakura: sakuraShot, neon: neonShot, mango: mangoShot, ocean: oceanShot };
const screens = await Promise.all(
  Object.entries(sources).map(async ([id, src]) => ({
    id,
    img: await getImage({ src, format: 'webp', width: 640 }),
  })),
);
---

<div id="phone-scene" class="relative mx-auto w-[min(280px,70vw)]" style="perspective: 1200px;">
  <div class="glow -inset-16" aria-hidden="true"></div>
  <span class="float-bit absolute -left-10 top-8 text-3xl" aria-hidden="true" data-depth="18">🍃</span>
  <span class="float-bit absolute -right-8 top-28 text-2xl" aria-hidden="true" data-depth="30">🪙</span>
  <span class="float-bit absolute -left-6 bottom-16 text-2xl" aria-hidden="true" data-depth="26">🪙</span>
  <span class="float-bit absolute -right-12 bottom-40 text-3xl" aria-hidden="true" data-depth="14">🍃</span>

  <div
    id="phone-frame"
    class="relative overflow-hidden rounded-[42px] border-4 theme-fade"
    style="border-color: color-mix(in srgb, var(--ink) 22%, var(--canvas)); background: var(--hero); box-shadow: 0 40px 90px -30px color-mix(in srgb, var(--hero-grad-2) 70%, black); transform-style: preserve-3d;"
  >
    <div class="absolute left-1/2 top-2.5 z-10 h-5 w-24 -translate-x-1/2 rounded-full" style="background: color-mix(in srgb, black 55%, var(--hero));" aria-hidden="true"></div>
    {screens.map(({ id, img }, i) => (
      <img
        src={img.src}
        width={img.attributes.width}
        height={img.attributes.height}
        alt={i === 0 ? 'Money Plant app: the Overview screen showing balance, income and spending' : ''}
        aria-hidden={i === 0 ? undefined : 'true'}
        data-screen={id}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        class="w-full transition-opacity duration-500"
        style={`display: block; ${i === 0 ? '' : 'position: absolute; inset: 0; opacity: 0;'}`}
      />
    ))}
  </div>
</div>

<script>
  import { currentTheme } from '../../lib/theme';
  function showTheme() {
    for (const image of document.querySelectorAll<HTMLElement>('[data-screen]')) image.style.opacity=image.dataset.screen===currentTheme().theme?'1':'0';
  }
  document.addEventListener('astro:page-load',showTheme);
  window.addEventListener('mp:theme',showTheme);
</script>
