---
import type { Release } from '../../lib/release-model';
import PhoneMock from './PhoneMock.astro';
import ThemeOrbs from './ThemeOrbs.astro';
import DownloadPanel from '../releases/DownloadPanel';
const { releases } = Astro.props as { releases: Release[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero" id="seed-area">
  <div class="container-site hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Your everyday money, thoughtfully tended</p>
      <h1>Simple finance.<br /><span>Private by default.</span></h1>
      <p class="hero-description">Track expenses, plan budgets and split bills. Your personal finances stay on your device, ready even when you’re offline.</p>
      <DownloadPanel releases={releases} base={base} client:load />
      <div class="action-row hero-links"><a class="text-link" href="#features">Explore features ↓</a><a class="text-link" href={`${base}/install`}>How to install</a></div>
      <p class="planned-note">Growing next: optional usernames for sharing selected splits. <a href="#sharing">See the plan →</a></p>
    </div>
    <div class="hero-product"><PhoneMock /><ThemeOrbs /></div>
  </div>
</section>
