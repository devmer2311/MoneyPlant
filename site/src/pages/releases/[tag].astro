---
import Base from '../../layouts/Base.astro';
import ReleaseNotes from '../../components/releases/ReleaseNotes';
import { getReleases, formatSize, releaseDate, type Release } from '../../lib/releases';
export async function getStaticPaths() {
  return (await getReleases()).map(release=>({params:{tag:release.tag},props:{release}}));
}
const {release}=Astro.props as {release:Release};
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const ordered=await getReleases();
const index=ordered.findIndex(r=>r.tag===release.tag);
const older=ordered[index+1], newer=ordered[index-1];
---
<Base title={`v${release.version} · Money Plant`} description={`Money Plant v${release.version}, released ${releaseDate(release.publishedAt)}. ${release.name}.`} ogImage={`${base}/og/releases-${release.tag.replaceAll('.','-')}.png`}>
  <article class="container-site release-detail">
    <a class="text-link" href={`${base}/releases`}>← All releases & latest download</a>
    <header class="section-heading"><p class="eyebrow">{release.prerelease?'Prerelease':`${release.kind} release`}</p><h1>v{release.version}</h1><p><time datetime={release.publishedAt}>{releaseDate(release.publishedAt)}</time>{release.apk && ` · ${formatSize(release.apk.size)}`}</p></header>
    <div class="panel"><h2>{release.name}</h2><p>{release.summary}</p><ReleaseNotes sections={release.sections}/>
      <div class="action-row">{release.apk ? <a class="button primary" href={release.apk.url}>Download Android APK <span>v{release.version} ↓</span></a> : <p>No Android APK is available for this release.</p>}<a class="text-link" href={release.htmlUrl}>Original GitHub release ↗</a></div>
      {release.apk && <details class="verify"><summary>Verify this download</summary><p>File: <code>{release.apk.name}</code></p><p>SHA-256: <code>{release.sha256 ?? 'Not supplied by GitHub. Check the release assets.'}</code></p><a class="text-link" href={`${base}/install#verify-title`}>How to compare the checksum →</a></details>}
    </div>
    <nav class="release-navigation" aria-label="Release navigation">{older && <a href={`${base}/releases/${older.tag}`}>← v{older.version}</a>}{newer && <a href={`${base}/releases/${newer.tag}`}>v{newer.version} →</a>}</nav>
  </article>
</Base>
