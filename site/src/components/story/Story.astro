---
import { Image } from 'astro:assets';
import overview from '../../assets/screens/garden/insights.png';
import splits from '../../assets/screens/garden/splits.png';
import settings from '../../assets/screens/garden/settings.png';
const chapters = [
 { label:'Personal finance', title:'See where it all goes.', body:'Track expenses and income, plan budgets and make room for the things you’re saving for.', shot:overview, alt:'Money Plant Insights screen with spending categories and reports', bullets:['Searchable ledger & reports','Budgets, recurring entries & goals','Statement imports & PDF exports'] },
 { label:'Splitting', title:'Good times. Fair shares.', body:'A shared chai or a whole trip. Split bills accurately and keep track without making anyone sign up.', shot:splits, alt:'Money Plant Splits screen with local people and outstanding balances', bullets:['Equal, percentage, share & itemised splits','People, groups & trip balances','Statements, UPI QR & nudges'] },
 { label:'Privacy & backup', title:'Keep your garden yours.', body:'Your phone holds your records. You choose when to export, back up or share them.', shot:settings, alt:'Money Plant Settings screen with backup, appearance and security controls', bullets:['Offline everyday use','Local backup & restore','Device authentication & five themes'] },
];
---
<section class="story-section" id="features">
  <div class="container-site section-heading"><p class="eyebrow">Room for the everyday</p><h2>A small app.<br />A well-tended money life.</h2><p>Three ways to make your money feel a little simpler.</p></div>
  <div class="container-site story-desktop">
    <div class="story-device-column"><div class="story-device">
      {chapters.map((c,i)=><Image src={c.shot} width={560} format="webp" alt={c.alt} loading="lazy" data-story-image={i} class:list={['story-screen',i===0&&'is-active']} />)}
    </div></div>
    <div class="story-chapters">{chapters.map((c,i)=><article class="story-chapter" data-story-chapter={i}>
      <p class="eyebrow">0{i+1} / {c.label}</p><h3>{c.title}</h3><p>{c.body}</p><ul>{c.bullets.map(b=><li>{b}</li>)}</ul>
    </article>)}</div>
  </div>
  <div class="story-mobile" data-scroll-story>
    <div class="story-sticky">
      <p class="story-scroll-hint">Scroll down to explore <span aria-hidden="true">↓</span></p>
      <div class="story-window"><div class="story-track">
        {chapters.map((c,i)=><article class="story-slide" data-slide={i} aria-label={`${i+1} of ${chapters.length}: ${c.label}`}>
          <div class="mobile-story-phone"><Image src={c.shot} width={400} format="webp" alt={c.alt} loading="lazy" /></div>
          <div class="mobile-story-copy"><p class="eyebrow">0{i+1} / {c.label}</p><h3>{c.title}</h3><p>{c.body}</p><ul>{c.bullets.map(b=><li>{b}</li>)}</ul></div>
        </article>)}
      </div></div>
      <nav class="story-dots" aria-label="Feature chapters">{chapters.map((c,i)=><button type="button" data-story-go={i} aria-label={`Show ${c.label}`} aria-current={i===0?'step':undefined}><span aria-hidden="true"></span><span class="sr-only">{c.label}</span></button>)}</nav>
    </div>
  </div>
</section>
<style>
  .story-section { padding-bottom: 0; }
  .story-desktop { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .story-device-column { position: relative; }
  .story-device { position: sticky; top: max(100px,calc((100svh - 540px)/2)); width: 250px; margin: 0 auto; border: 4px solid color-mix(in srgb,var(--ink) 22%,var(--canvas)); border-radius: 32px; overflow: hidden; box-shadow: 0 24px 60px #0002; }
  .story-screen { width: 100%; display: block; opacity: 0; position: absolute; inset: 0; transition: opacity .35s ease; }
  .story-screen:first-child { position: relative; }
  .story-screen.is-active { opacity: 1; }
  .story-chapter { min-height: 75svh; display: flex; flex-direction: column; justify-content: center; padding: 3rem 0; }
  .story-chapter h3 { font-size: clamp(2rem,3.5vw,3rem); margin: 0 0 1rem; }
  .story-chapter > p:not(.eyebrow) { max-width: 42ch; color: var(--ink-muted); font-size: 1.1rem; }
  .story-chapter ul { padding-left: 1.2rem; }
  .story-chapter li { margin: .5rem 0; }
  .story-mobile { display: none; }
  @media (max-width:767px) {
    .story-desktop { display:none; }
    .story-mobile { display:block; }
    .story-slide { padding: 1rem; margin-bottom: 2rem; text-align:center; }
    .mobile-story-phone { width: fit-content; max-width: 70%; margin: 0 auto 1rem; border: 3px solid color-mix(in srgb,var(--ink) 24%,transparent); border-radius:24px; overflow:hidden; box-shadow:0 18px 35px #0002; }
    .mobile-story-phone img { display:block; width:auto; max-height: min(38svh,320px); }
    .mobile-story-copy { max-width: 38ch; margin-inline:auto; }
    .mobile-story-copy .eyebrow { font-size:.65rem; margin-bottom:.4rem; }
    .mobile-story-copy h3 { margin:0 0 .6rem; font-size:1.65rem; line-height:1.15; }
    .mobile-story-copy > p:not(.eyebrow) { font-size:.9rem; color:var(--ink-muted); margin:0; }
    .mobile-story-copy ul { display:flex; justify-content:center; flex-wrap:wrap; list-style:none; gap:.3rem .65rem; padding:0; margin:.75rem 0 0; font-size:.7rem; color:var(--ink-muted); }
    .mobile-story-copy li { border-bottom:1px solid color-mix(in srgb,var(--ink) 18%,transparent); padding:.15rem; }
    .story-scroll-hint { display:none; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-muted); text-align:center; margin:0; }
    .story-dots { display:none; justify-content:center; }
    .story-dots button { display:grid; place-items:center; width:44px; height:44px; background:none; border:0; }
    .story-dots button span:first-child { width:8px; height:8px; border-radius:8px; background:var(--ink-muted); opacity:.5; transition:width .2s; }
    .story-dots button[aria-current='step'] span:first-child { width:24px; opacity:1; background:var(--ink); }
    .story-mobile.is-scroll { height:300svh; }
    .is-scroll .story-sticky { position:sticky; top:64px; height:calc(100svh - 64px); display:flex; flex-direction:column; justify-content:center; overflow:hidden; }
    .is-scroll .story-scroll-hint, .is-scroll .story-dots { display:flex; justify-content:center; gap:.6rem; }
    .is-scroll .story-window { width:100%; overflow:hidden; }
    .is-scroll .story-track { display:flex; will-change:transform; }
    .is-scroll .story-slide { flex:0 0 100%; width:100%; margin:0; padding:.75rem 1rem 0; }
  }
  @media (prefers-reduced-motion:reduce) { .story-screen { transition:none; } }
</style>
<script>
  function initStory() {
    const root=document.querySelector<HTMLElement>('[data-scroll-story]');
    if(!root) return;
    const media=matchMedia('(max-width:767px) and (min-height:620px) and (prefers-reduced-motion:no-preference)');
    const track=root.querySelector<HTMLElement>('.story-track')!;
    const slides=[...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots=[...root.querySelectorAll<HTMLButtonElement>('[data-story-go]')];
    let frame=0;
    const update=()=>{
      frame=0;
      if(!media.matches) return;
      const rect=root.getBoundingClientRect();
      const distance=Math.max(1,root.offsetHeight-(innerHeight-64));
      const progress=Math.max(0,Math.min(1,(64-rect.top)/distance));
      // Hold each chapter briefly; move horizontally through the middle of each interval.
      const phase=progress*(slides.length-1);
      const whole=Math.floor(phase), fraction=phase-whole;
      const blend=Math.max(0,Math.min(1,(fraction-.2)/.6));
      const position=whole+blend*blend*(3-2*blend);
      track.style.transform=`translateX(-${position*100}%)`;
      const active=Math.round(position);
      slides.forEach((s,i)=>{s.inert=i!==active;s.setAttribute('aria-hidden',String(i!==active));});
      dots.forEach((d,i)=>i===active?d.setAttribute('aria-current','step'):d.removeAttribute('aria-current'));
    };
    const schedule=()=>{if(!frame) frame=requestAnimationFrame(update);};
    const configure=()=>{
      root.classList.toggle('is-scroll',media.matches);
      track.style.transform='';
      slides.forEach(s=>{s.inert=false;s.removeAttribute('aria-hidden');});
      schedule();
    };
    dots.forEach((d,i)=>d.onclick=()=>{
      const distance=root.offsetHeight-(innerHeight-64);
      window.scrollTo({top:window.scrollY+root.getBoundingClientRect().top-64+distance*i/(slides.length-1),behavior:'smooth'});
    });
    const io=new IntersectionObserver(entries=>{
      for(const entry of entries) if(entry.isIntersecting) {
        const index=(entry.target as HTMLElement).dataset.storyChapter;
        document.querySelectorAll<HTMLElement>('[data-story-image]').forEach(img=>img.classList.toggle('is-active',img.dataset.storyImage===index));
      }
    },{rootMargin:'-35% 0px -35% 0px',threshold:0});
    document.querySelectorAll('[data-story-chapter]').forEach(el=>io.observe(el));
    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('resize',configure);
    media.addEventListener('change',configure);
    configure();
    document.addEventListener('astro:before-swap',()=>{
      io.disconnect();cancelAnimationFrame(frame);
      window.removeEventListener('scroll',schedule);window.removeEventListener('resize',configure);media.removeEventListener('change',configure);
    },{once:true});
  }
  document.addEventListener('astro:page-load',initStory);
</script>
