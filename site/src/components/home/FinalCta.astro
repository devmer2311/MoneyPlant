---
// A giant plant draws itself as you reach the bottom, then the seed CTA again.
import { STABLE_APK_URL } from '../../lib/releases.ts';

interface Props {
  version: string;
}
const { version } = Astro.props;
---

<section class="relative overflow-hidden text-center">
  <div class="glow left-1/2 top-1/3 size-[34rem] -translate-x-1/2" aria-hidden="true"></div>
  <div class="container-site relative">
    <svg id="cta-plant" class="mx-auto block w-40 md:w-56" viewBox="0 0 200 260" fill="none" aria-hidden="true">
      <path class="plant-path" d="M100 250 C 100 200, 96 170, 100 130 C 104 96, 98 70, 100 40" stroke="var(--leaf-mid)" stroke-width="6" stroke-linecap="round" />
      <path class="plant-path" d="M100 170 C 74 160, 56 138, 52 108 C 82 112, 98 136, 100 164" fill="var(--leaf-hi)" stroke="var(--leaf-shade)" stroke-width="3" />
      <path class="plant-path" d="M100 130 C 126 120, 144 98, 148 68 C 118 72, 102 96, 100 124" fill="var(--leaf-mid)" stroke="var(--leaf-shade)" stroke-width="3" />
      <path class="plant-path" d="M100 40 C 88 26, 88 12, 100 2 C 112 12, 112 26, 100 40" fill="var(--leaf-hi)" stroke="var(--leaf-shade)" stroke-width="3" />
      <path d="M64 250 L 136 250 L 128 218 L 72 218 Z" fill="var(--coin-shade)" stroke="var(--coin-edge)" stroke-width="3" />
    </svg>
    <h2 class="m-0 mt-8" style="font-size: clamp(2.6rem, 7vw, 5.5rem); letter-spacing: -0.03em;">
      Plant yours today.
    </h2>
    <p class="mx-auto mt-4 max-w-[40ch] text-lg text-ink-muted">
      Free forever, no account, and your money stays yours.
    </p>
    <p class="mt-8">
      <a
        href={STABLE_APK_URL}
        data-latest-apk
        class="inline-block rounded-full px-12 py-5 text-xl font-bold no-underline"
        style="background: var(--brand); color: var(--on-brand); box-shadow: 0 10px 50px -12px var(--brand); font-family: var(--font-display);"
      >
        Download for Android · <span data-latest-version>v{version}</span>
      </a>
    </p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function init() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const paths = document.querySelectorAll<SVGPathElement>('#cta-plant .plant-path');
    for (const path of paths) {
      const len = path.getTotalLength();
      gsap.fromTo(
        path,
        { strokeDasharray: len, strokeDashoffset: len, fillOpacity: 0 },
        {
          strokeDashoffset: 0,
          fillOpacity: 1,
          ease: 'none',
          scrollTrigger: { trigger: '#cta-plant', start: 'top 90%', end: 'bottom 55%', scrub: 0.5 },
        },
      );
    }
  }
  document.addEventListener('astro:page-load', init);
</script>
