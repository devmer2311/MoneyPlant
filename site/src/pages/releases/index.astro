---
import Base from '../../layouts/Base.astro';
import ReleasesExplorer from '../../components/releases/ReleasesExplorer.tsx';
import type { VineRelease } from '../../components/releases/ReleasesExplorer.tsx';
import { formatSize, getReleases, relativeTime, stableReleases, totalDownloads } from '../../lib/releases.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getReleases();
const stable = stableReleases(releases);
const downloads = totalDownloads(releases);
const first = stable.at(-1);
const latest = stable[0];

// Average days between releases, for the cadence stat.
const gaps =
  stable.length > 1
    ? Math.round(
        (new Date(stable[0]!.publishedAt).getTime() - new Date(first!.publishedAt).getTime()) /
          86_400_000 /
          (stable.length - 1),
      )
    : 0;

const vineData: VineRelease[] = releases.map((r) => ({
  tag: r.tag,
  version: r.version,
  publishedAt: r.publishedAt,
  relative: relativeTime(r.publishedAt),
  kind: r.kind,
  prerelease: r.prerelease,
  downloads: r.apk?.downloads ?? 0,
  sizeLabel: r.apk ? formatSize(r.apk.size) : '',
  apkUrl: r.apk?.url,
  detailUrl: `${base}/releases/${r.tag}`,
  bullets: [...r.sections.new, ...r.sections.fixes, ...r.sections.design, ...r.sections.other],
  sections: r.sections,
}));

const stats = [
  { label: 'releases', value: stable.length, ticker: true },
  { label: 'seeds planted', value: downloads, ticker: true },
  { label: 'first seed', value: first ? new Date(first.publishedAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) : 'soon' },
  { label: 'cadence', value: gaps > 0 ? `every ~${gaps} days` : 'just planted 🌱' },
];
---

<Base
  title="Releases · Money Plant"
  description={`Every Money Plant release on the growth vine. Latest: v${latest?.version}.`}
  ogImage={`${base}/og/releases.png`}
>
  <section class="container-site !pt-14">
    <h1 class="m-0" style="font-size: clamp(2.6rem, 6vw, 4.5rem); letter-spacing: -0.03em;">The growth vine</h1>
    <p class="mt-3 max-w-[55ch] text-ink-muted">Every version of Money Plant, newest at the top. Watch the vine grow.</p>

    <dl class="mt-8 flex flex-wrap gap-x-12 gap-y-4">
      {stats.map((s) => (
        <div>
          <dt class="text-xs font-bold uppercase tracking-wide text-ink-muted">{s.label}</dt>
          <dd
            class="m-0 text-3xl font-bold"
            style="font-family: var(--font-display); font-variant-numeric: tabular-nums;"
            data-ticker={s.ticker ? s.value : undefined}
          >
            {s.value}
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-12">
      <ReleasesExplorer releases={vineData} client:load />
    </div>
  </section>
</Base>

<script>
  import gsap from 'gsap';

  document.addEventListener('astro:page-load', () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const el of document.querySelectorAll<HTMLElement>('[data-ticker]')) {
      const target = Number(el.dataset.ticker);
      if (!Number.isFinite(target)) continue;
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 1.2,
        ease: 'power2.out',
        onUpdate: () => (el.textContent = Math.round(obj.v).toLocaleString('en-IN')),
        scrollTrigger: { trigger: el, start: 'top 90%' },
      });
    }
  });

  import { initLatestCheck } from '../../lib/latest';
  document.addEventListener('astro:page-load', () => {
    const first = document.querySelector('.release-card h3')?.textContent?.replace(/^v/, '');
    if (first) void initLatestCheck(first.trim());
  });
</script>
