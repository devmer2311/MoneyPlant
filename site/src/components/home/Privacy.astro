---
// "Your data never leaves the pot": particles fly at the cloud, bounce off the
// shield, and fall back into the pot. Three claims, one honest footnote.
const claims = [
  { icon: '🙅', title: 'No account', body: 'No sign-up, no email, no OTP. Open the app and start.' },
  { icon: '🏦', title: 'No bank login', body: 'Import statements as files you choose. Credentials never asked.' },
  { icon: '📵', title: 'No servers', body: 'Everything lives in your phone’s storage. Airplane mode is fine.' },
];
---

<section class="container-site">
  <h2 class="m-0 max-w-[18ch]" style="font-size: clamp(2.2rem, 5vw, 3.6rem);">Your data never leaves the pot</h2>

  <div class="mt-10 grid items-center gap-10 lg:grid-cols-2">
    <div class="relative h-64 rounded-[var(--radius)]" style="background: var(--surface);">
      <canvas id="privacy-canvas" class="absolute inset-0 size-full" aria-hidden="true"></canvas>
      <span class="absolute right-6 top-6 text-4xl opacity-60" aria-hidden="true">☁️</span>
      <span id="privacy-shield" class="absolute right-24 top-1/2 -translate-y-1/2 text-4xl" style="filter: drop-shadow(0 0 12px var(--brand));" aria-hidden="true">🛡️</span>
      <span class="absolute bottom-4 left-10 text-4xl" aria-hidden="true">🪴</span>
    </div>

    <ul class="m-0 grid list-none gap-5 p-0">
      {claims.map((c) => (
        <li class="flex items-start gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl text-2xl" style="background: var(--surface-alt);" aria-hidden="true">{c.icon}</span>
          <div>
            <h3 class="m-0 text-xl">{c.title}</h3>
            <p class="m-0 text-ink-muted">{c.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <p class="mt-8 max-w-[70ch] text-sm text-ink-muted">
    The honest footnote: because there are no servers, there is no automatic cloud backup either.
    Export a backup file from Settings now and then, and keep it somewhere safe.
  </p>
</section>

<script>
  function init() {
    const canvas = document.getElementById('privacy-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    type P = { x: number; y: number; vx: number; vy: number; bounced: boolean };
    let parts: P[] = [];
    let running = false;
    let raf = 0;
    let w = 0;
    let h = 0;

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    addEventListener('resize', resize);

    const spawn = () => {
      if (parts.length < 14 && Math.random() < 0.1) {
        parts.push({ x: 40 + Math.random() * 40, y: h - 50, vx: 90 + Math.random() * 60, vy: -(70 + Math.random() * 50), bounced: false });
      }
    };

    let last = performance.now();
    const shieldX = () => w - 120;
    const loop = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      ctx.clearRect(0, 0, w, h);
      spawn();
      const brand = getComputedStyle(document.documentElement).getPropertyValue('--brand').trim();
      parts = parts.filter((p) => p.y < h - 30 || !p.bounced);
      for (const p of parts) {
        if (!p.bounced && p.x >= shieldX()) {
          p.bounced = true;
          p.vx = -Math.abs(p.vx) * 0.6;
          p.vy = -40;
        }
        if (p.bounced) p.vy += 220 * dt; // gravity pulls it back to the pot
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        ctx.globalAlpha = 0.9;
        ctx.fillStyle = p.bounced ? brand : 'color-mix(in srgb, ' + brand + ' 60%, white)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (running) raf = requestAnimationFrame(loop);
    };

    const io = new IntersectionObserver(([e]) => {
      if (e!.isIntersecting && !running) {
        running = true;
        last = performance.now();
        raf = requestAnimationFrame(loop);
      } else if (!e!.isIntersecting) {
        running = false;
        cancelAnimationFrame(raf);
      }
    });
    io.observe(canvas);
  }
  document.addEventListener('astro:page-load', init);
</script>
