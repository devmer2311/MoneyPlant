---
import { themePacks } from '../lib/themes';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [{href:`${base}/#features`,label:'Features'},{href:`${base}/releases`,label:'Releases'},{href:`${base}/install`,label:'Install'},{href:`${base}/roadmap`,label:'Roadmap'}];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="site-header"><div class="container-site header-row">
  <a href={`${base}/`} class="site-logo"><span aria-hidden="true">🌱</span> Money Plant</a>
  <nav class="desktop-nav" aria-label="Main">{links.map(l=><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}</nav>
  <div class="header-actions">
    <details class="theme-picker"><summary aria-label="Choose site appearance">◐ <span class="appearance-label">Appearance</span></summary>
      <div class="theme-menu panel"><p class="eyebrow">Make it your garden</p>
        <div class="theme-options">{themePacks.map(p=><button type="button" data-theme-choice={p.id} aria-pressed="false"><span aria-hidden="true">{p.emoji}</span>{p.name}</button>)}</div>
        <button type="button" id="mode-toggle" class="button secondary" aria-label="Switch between dark and light mode">Switch to light mode</button>
      </div>
    </details>
    <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Mobile">{links.map(l=><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}<a href="https://github.com/devmer2311/MoneyPlant">GitHub ↗</a></nav></details>
  </div>
</div></header>
<script>
  import { currentTheme, setTheme } from '../lib/theme';
  function mark() {
    const {theme,mode}=currentTheme();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.themeChoice===theme)));
    const button=document.getElementById('mode-toggle');
    if(button) button.textContent=mode==='dark'?'Switch to light mode':'Switch to dark mode';
  }
  document.addEventListener('astro:page-load',()=>{
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach(b=>b.onclick=()=>setTheme(b.dataset.themeChoice!,currentTheme().mode));
    const button=document.getElementById('mode-toggle');
    if(button) button.onclick=()=>{const c=currentTheme();setTheme(c.theme,c.mode==='dark'?'light':'dark');};
    mark();
  });
  window.addEventListener('mp:theme',mark);
  document.addEventListener('keydown',e=>{
    if(e.key!=='Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach(d=>{d.open=false;d.querySelector('summary')?.focus();});
  });
  document.addEventListener('click',e=>{
    document.querySelectorAll<HTMLDetailsElement>('.site-header details[open]').forEach(d=>{if(!d.contains(e.target as Node)) d.open=false;});
    if((e.target as Element).closest('.mobile-menu a')) document.querySelector<HTMLDetailsElement>('.mobile-menu')?.removeAttribute('open');
  });
</script>
