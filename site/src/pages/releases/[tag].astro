---
import Base from '../../layouts/Base.astro';
import { formatSize, getReleases, latestRelease, relativeTime, type Release } from '../../lib/releases.ts';

export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((release) => ({ params: { tag: release.tag }, props: { release } }));
}

interface Props {
  release: Release;
}
const { release } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getReleases();
const latest = latestRelease(releases);
const isLatest = latest?.tag === release.tag;
const ordered = releases.filter((r) => !r.prerelease || r.tag === release.tag);
const index = ordered.findIndex((r) => r.tag === release.tag);
const prev = ordered[index + 1]; // older
const next = ordered[index - 1]; // newer
const date = new Date(release.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const kindLabel = { major: '🌸 major', minor: '🍃 minor', patch: '🌿 patch' }[release.kind];
---

<Base
  title={`v${release.version} · Money Plant`}
  description={`Money Plant v${release.version}, released ${date}. Download the APK and read the changelog.`}
  ogImage={`${base}/og/releases-${release.tag.replaceAll('.', '-')}.png`}
>
  <article class="container-site !pt-14">
    <p class="m-0 text-sm font-bold text-ink-muted">
      <a href={`${base}/releases`} class="no-underline hover:underline" style="color: var(--ink-muted);">← All releases</a>
    </p>
    <header class="mt-6">
      <h1
        class="m-0"
        style={`font-size: clamp(4rem, 12vw, 9rem); letter-spacing: -0.04em; view-transition-name: release-${release.version.replaceAll('.', '-')};`}
      >
        v{release.version}
      </h1>
      <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-ink-muted" style="font-variant-numeric: tabular-nums;">
        <span>{date} · {relativeTime(release.publishedAt)}</span>
        <span class="rounded-full border px-3 py-0.5 text-xs font-bold" style="border-color: color-mix(in srgb, var(--ink) 18%, transparent);">{kindLabel}</span>
        {release.apk && <span>{formatSize(release.apk.size)}</span>}
        {release.apk && release.apk.downloads > 0 && <span>{release.apk.downloads.toLocaleString('en-IN')} downloads</span>}
        {release.prerelease && <span class="rounded-full px-3 py-0.5 text-xs font-bold" style="background: var(--owe); color: var(--on-owe);">beta</span>}
      </p>
    </header>

    {!isLatest && latest && (
      <p class="mt-6 rounded-2xl border px-5 py-3 text-sm font-bold" style="border-color: var(--chart-5); background: color-mix(in srgb, var(--chart-5) 14%, var(--surface)); color: var(--ink);">
        ⚠ A newer version (v{latest.version}) is available.
        <a href={`${base}/releases/${latest.tag}`} class="underline" style="color: var(--ink);">See what's new →</a>
      </p>
    )}

    <p class="mt-8 flex flex-wrap items-center gap-4">
      {release.apk && (
        <a
          href={release.apk.url}
          class="rounded-full px-8 py-3.5 text-lg font-bold no-underline"
          style="background: var(--brand); color: var(--on-brand); box-shadow: 0 8px 40px -10px var(--brand); font-family: var(--font-display);"
        >
          Download v{release.version}
        </a>
      )}
      <button
        id="share-release"
        type="button"
        class="rounded-full border px-6 py-3.5 font-bold"
        style="border-color: color-mix(in srgb, var(--ink) 18%, transparent); color: var(--ink); background: transparent;"
      >
        Share
      </button>
    </p>

    {release.sha256 && release.apk && (
      <section class="mt-10 max-w-2xl rounded-[var(--radius)] border p-6 !py-6" style="border-color: color-mix(in srgb, var(--ink) 12%, transparent); background: var(--surface);">
        <h2 class="mt-0 text-xl">Verify your download</h2>
        <p class="flex items-center gap-2 text-sm">
          <code class="min-w-0 flex-1 break-all text-xs text-ink-muted">{release.sha256}</code>
          <button type="button" class="copy-sha shrink-0 rounded-full px-3 py-1 text-xs font-bold" style="background: var(--surface-alt); color: var(--ink);" data-sha={release.sha256}>Copy</button>
        </p>
        <p class="m-0 text-sm text-ink-muted">
          Windows: <code>certutil -hashfile {release.apk.name} SHA256</code> · Linux/macOS: <code>sha256sum {release.apk.name}</code>
        </p>
      </section>
    )}

    <section class="release-notes prose-notes mt-10 max-w-2xl" set:html={release.bodyHtml || '<p>No notes for this release.</p>'} />

    <nav class="mt-14 flex justify-between gap-4 border-t pt-8" style="border-color: color-mix(in srgb, var(--ink) 10%, transparent);" aria-label="Release navigation">
      {prev ? (
        <a id="nav-prev" href={`${base}/releases/${prev.tag}`} class="font-bold no-underline hover:underline" style="color: var(--ink);">← v{prev.version}</a>
      ) : (
        <span class="text-ink-muted">The first seed 🌱</span>
      )}
      {next ? (
        <a id="nav-next" href={`${base}/releases/${next.tag}`} class="font-bold no-underline hover:underline" style="color: var(--ink);">v{next.version} →</a>
      ) : (
        <span class="text-ink-muted">You're on the newest leaf</span>
      )}
    </nav>
  </article>
</Base>

<style>
  .prose-notes :global(h1),
  .prose-notes :global(h2),
  .prose-notes :global(h3) {
    font-family: var(--font-display);
    margin-top: 1.6em;
  }
  .prose-notes :global(a) {
    color: var(--brand);
    overflow-wrap: anywhere;
  }
  .prose-notes :global(li) {
    margin-block: 0.35em;
  }
  .prose-notes :global(code) {
    background: var(--surface-alt);
    padding: 0.1em 0.35em;
    border-radius: 6px;
    font-size: 0.9em;
  }
  .prose-notes :global(img) {
    max-width: 100%;
    border-radius: 12px;
  }
</style>

<script>
  function init() {
    document.querySelector('.copy-sha')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(btn.dataset.sha ?? '');
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = 'Select it manually';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2500);
    });

    document.getElementById('share-release')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else {
          await navigator.clipboard.writeText(location.href);
          btn.textContent = 'Link copied ✓';
          setTimeout(() => (btn.textContent = 'Share'), 2500);
        }
      } catch {
        /* user cancelled the share sheet */
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement) return;
      if (e.key === 'ArrowLeft') (document.getElementById('nav-prev') as HTMLAnchorElement | null)?.click();
      if (e.key === 'ArrowRight') (document.getElementById('nav-next') as HTMLAnchorElement | null)?.click();
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
