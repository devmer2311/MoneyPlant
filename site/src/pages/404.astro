---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found · Money Plant" description="This page didn't sprout. Head back to the Money Plant garden.">
  <section class="container-site grid min-h-[70dvh] content-center justify-items-center text-center">
    <div id="wilted" class="text-8xl transition-transform duration-500" style="transform: rotate(35deg) translateY(10px); transform-origin: bottom center;" aria-hidden="true">
      🥀
    </div>
    <h1 class="m-0 mt-6" style="font-size: clamp(2.4rem, 6vw, 4rem);">This page didn't sprout</h1>
    <p class="mt-3 max-w-[40ch] text-ink-muted">
      Move your cursor closer, it perks up. The page you wanted is gone or never grew.
    </p>
    <p class="mt-6 flex flex-wrap justify-center gap-4">
      <a href={`${base}/`} class="rounded-full px-8 py-3 font-bold no-underline" style="background: var(--brand); color: var(--on-brand);">Back to the garden</a>
      <a href={`${base}/releases`} class="rounded-full border px-8 py-3 font-bold no-underline" style="border-color: color-mix(in srgb, var(--ink) 18%, transparent); color: var(--ink);">Releases</a>
    </p>
  </section>
</Base>

<script>
  function init() {
    const plant = document.getElementById('wilted');
    if (!plant || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const perk = (e: PointerEvent) => {
      const r = plant.getBoundingClientRect();
      const d = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
      const t = Math.min(Math.max((260 - d) / 260, 0), 1); // 0 far → 1 close
      plant.style.transform = `rotate(${35 * (1 - t)}deg) translateY(${10 * (1 - t)}px) scale(${1 + t * 0.15})`;
      plant.textContent = t > 0.75 ? '🌱' : '🥀';
    };
    document.addEventListener('pointermove', perk);
  }
  document.addEventListener('astro:page-load', init);
</script>
