---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import Story from '../components/story/Story.astro';
import Privacy from '../components/home/Privacy.astro';
import Faq from '../components/home/Faq.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import SplitCalculator from '../components/calc/SplitCalculator.tsx';
import DownloadPanel from '../components/releases/DownloadPanel';
import { getReleases } from '../lib/releases';
const releases = await getReleases();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Money Plant — Private, Offline-First Personal Finance" description="Track expenses, budgets and local bill splits on Android. No mandatory account. Local backup and restore, with optional username sharing planned.">
  <Hero releases={releases} />
  <div class="trust-strip container-site" aria-label="Money Plant at a glance">
    <span>🌱 No mandatory account</span><span>◎ Everyday tracking works offline</span><span>↗ Export your own backups</span>
  </div>
  <Story />
  <Privacy />
  <HowItWorks kind="split" />
  <HowItWorks kind="backup" />
  <section class="container-site" id="try-split">
    <div class="section-heading"><p class="eyebrow">A little preview</p><h2>One bill. A fair split.</h2><p>Try the app’s paise-exact split calculation here. This demo stays in your browser.</p></div>
    <div class="calculator-wrap"><SplitCalculator client:visible /></div>
  </section>
  <section class="container-site" id="download">
    <div class="section-heading"><p class="eyebrow">Ready when you are</p><h2>Plant it on your phone.</h2><p>The latest Android download and a clear account of what changed.</p></div>
    <DownloadPanel releases={releases} base={base} expanded client:load />
    <p class="text-ink-muted">New to APKs? <a class="text-link" href={`${base}/install`}>Follow the installation guide →</a></p>
  </section>
  <Faq />
  <section class="container-site final-cta"><span aria-hidden="true">🌱</span><h2>A little clarity, every day.</h2><a class="button primary" href="#download">Get Money Plant for Android ↑</a></section>
</Base>
